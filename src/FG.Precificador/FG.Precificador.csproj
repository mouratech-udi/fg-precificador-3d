    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FG.Precificador</AssemblyName><RootNamespace>FG.Precificador</RootNamespace><Version>1.4.0</Version>
