  <ItemGroup><EmbeddedResource Include="Marca-FG.png" LogicalName="FG.Marca" /></ItemGroup>
  <ItemGroup><PackageReference Include="PDFsharp-GDI" Version="6.2.4" /></ItemGroup>
</Project>
